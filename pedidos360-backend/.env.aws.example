# EC2 "app". Uso:  cp .env.aws.example .env   y completa los valores. El .env NO se sube a GitHub.
# IPs PRIVADAS (las que empiezan con 172.31...) de las otras máquinas
RABBITMQ_NODO1=172.31.0.10
RABBITMQ_NODO2=172.31.0.11
KAFKA_HOST=172.31.0.20
# Usuario y clave que definiste en los nodos RabbitMQ (no uses guest)
RABBITMQ_USER=pedidos
RABBITMQ_PASSWORD=cambia-esta-clave
# RDS PostgreSQL
DB_HOST=pedidos360-db.xxxxxxxx.us-east-1.rds.amazonaws.com
DB_NAME=pedidos360
DB_USER=pedidosadmin
DB_PASSWORD=cambia-esta-clave
# Origen permitido por CORS en el BFF (el del frontend)
CORS_ORIGENES=http://localhost:4200
# Opcionales: validación de issuer y audiencia del JWT en el BFF
JWT_ISSUER=
JWT_AUDIENCE=
